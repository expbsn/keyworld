# DataForSEO — https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=your-email@example.com
DATAFORSEO_PASSWORD=your-api-password

# Markt-Defaults (2276 = Deutschland)
KEYWORLD_LOCATION_CODE=2276
KEYWORLD_LANGUAGE_CODE=de

# Kosten-Schutzschalter: Abbruch, wenn ein Run diese Summe (USD) reissen wuerde
KEYWORLD_RUN_BUDGET_USD=2.00

# Cache-Lebensdauer in Tagen (Suchvolumina aendern sich monatlich, nicht taeglich)
KEYWORLD_CACHE_TTL_DAYS=30

# Sprachmodell fuer Einschaetzung und Dialog im Interface
# https://platform.deepseek.com/api_keys -- Server in China, siehe README
DEEPSEEK_API_KEY=
KEYWORLD_LLM_MODEL=deepseek-v4-pro
KEYWORLD_LLM_MODEL_SCHNELL=deepseek-flash
